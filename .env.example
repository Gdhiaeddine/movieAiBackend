# Path to the pickled (DataFrame, csr_matrix) model.
# If unset, the backend auto-detects movies_and_tfidf.pkl in ./, ../, or ../../
# MODEL_PATH=C:\path\to\movies_and_tfidf.pkl

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=*
DEFAULT_LIMIT=10
MAX_LIMIT=50
ENABLE_POSTER_FETCH=true
POSTER_CACHE_PATH=poster_cache.json
POSTER_FETCH_TIMEOUT=5.0
POSTER_FETCH_CONCURRENCY=8

# On deploy hosts that don't ship the .pkl (Render, Fly.io, etc.),
# set these to fetch the model on first startup. Otherwise leave blank.
MODEL_DOWNLOAD_URL=
MODEL_DOWNLOAD_SHA256=

